{
  "name": "@async-jobs/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --include '../../packages/*/src/**/*.ts' --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@async-jobs/contracts": "workspace:*",
    "@async-jobs/database": "workspace:*",
    "express": "^5.2.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
