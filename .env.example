# Local development connection; Compose builds its own internal DATABASE_URL.
DATABASE_URL=postgres://jobs:jobs@127.0.0.1:5432/jobs
POSTGRES_USER=jobs
POSTGRES_PASSWORD=jobs
POSTGRES_DB=jobs
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=8080
# Local worker defaults: poll every 500ms and retain a 30-second lease per claim.
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_DURATION_MS=30000
# Chaos controls (fail_task, crash_worker) are rejected at job submission unless this is true.
ENABLE_CHAOS=false
